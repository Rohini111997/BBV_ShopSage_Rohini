# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Postgres connection string (Neon: dashboard -> your project -> Connect ->
# "Connection string", pooled connection).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require

# Existing app secrets (see src/ for usage)
GROQ_API_KEY=

# Optional: LangSmith tracing. Leave unset and the app runs exactly as before —
# the in-app agent-trace panel works either way. Needs BOTH vars to switch on.
# Key from https://smith.langchain.com -> Settings -> API Keys.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=shopsage
